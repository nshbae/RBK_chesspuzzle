    \uB6F0\uC5B4\uB118\uC744 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
  - "\uBE44\uC20D\uC740 \uB300\uAC01\uC120\uC73C\uB85C \uC6D0\uD558\uB294 \uAC70\uB9AC\uB85C
    \uC774\uB3D9\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4. \uC801\uACFC \uC7A5\uC560\uBB3C\uC744
    \uB6F0\uC5B4\uB118\uC744 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
  - "\uB098\uC774\uD2B8\uB294 1*2 \uB5A8\uC5B4\uC9C4 \uCE78\uC73C\uB85C \uC774\uB3D9\uD560
    \uC218 \uC788\uC2B5\uB2C8\uB2E4. \uC801\uACFC \uC7A5\uC560\uBB3C\uC744 \uB6F0\uC5B4\uB118\uC744
    \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  - "\uD504\uB9B0\uC138\uC2A4\uB294 \uC0C1\uD558\uC88C\uC6B0, \uB300\uAC01\uC120\uC73C\uB85C
    1\uCE78 \uC774\uB3D9\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  - 
  - "\uD038\uC740 \uB8E9\uACFC \uBE44\uC20D\uCC98\uB7FC \uC774\uB3D9\uD560 \uC218
    \uC788\uC2B5\uB2C8\uB2E4. \uC801\uACFC \uC7A5\uC560\uBB3C\uC744 \uB6F0\uC5B4\uB118\uC744
    \uC218 \uC5C6\uC2B5\uB2C8\uB2E4. \uB8E9\uACFC \uBE44\uC20D\uC744 \uACF5\uACA9\uD560
    \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
  - "\uD06C\uB85C\uC6B0\uC740 \uBE44\uC20D\uACFC \uB098\uC774\uD2B8\uCC98\uB7FC \uC774\uB3D9\uD560
    \uC218 \uC788\uC2B5\uB2C8\uB2E4. \uBE44\uC20D\uC73C\uB85C \uC774\uB3D9\uD560
    \uB54C\uB294 \uC801\uACFC \uC7A5\uC560\uBB3C\uC744 \uB6F0\uC5B4\uB118\uC744 \uC218
    \uC5C6\uC2B5\uB2C8\uB2E4. \uBE44\uC20D\uACFC \uB098\uC774\uD2B8\uB97C \uACF5\uACA9\uD560
    \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
  - "\uB4DC\uB798\uACE4\uC740 \uB098\uC774\uD2B8\uC640 \uB8E9\uCC98\uB7FC \uC774\uB3D9\uD560
    \uC218 \uC788\uC2B5\uB2C8\uB2E4. \uB8E9\uC73C\uB85C \uC774\uB3D9\uD560 \uB54C\uB294
    \uC801\uACFC \uC7A5\uC560\uBB3C\uC744 \uB6F0\uC5B4\uB118\uC744 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4.
    \uB098\uC774\uD2B8\uC640 \uB8E9\uC744 \uACF5\uB825\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
  - "\uC720\uB2C8\uCF58\uC740 \uB8E9\uACFC \uBE44\uC20D, \uB098\uC774\uD2B8\uCC98\uB7FC
    \uC774\uB3D9\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4. \uB8E9\uACFC \uBE44\uC20D\uCC98\uB7FC
    \uC774\uB3D9\uD560 \uB54C\uB294 \uC801\uACFC \uC7A5\uC560\uBB3C\uC744 \uB6F0\uC5B4\uB118\uC744
    \uC218 \uC5C6\uC2B5\uB2C8\uB2E4. \uBAA8\uB4E0 \uAE30\uBB3C\uC744 \uACF5\uACA9\uD560
    \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  - "\uB9E4 \uC2A4\uD14C\uC774\uC9C0\uAC00 \uC2DC\uC791\uB420 \uB54C \uAC00\uC9C0\uACE0
    \uC788\uB294 \uBB34\uC791\uC704 \uCCB4\uC2A4\uB9D0 \uC911 \uD558\uB098\uB85C
    \uBC14\uB01D\uB2C8\uB2E4. "
  - "\uC0C1\uD558\uC88C\uC6B0 \uB610\uB294 \uB300\uAC01\uC120\uC73C\uB85C 1\uCE78
    \uB610\uB294 2\uCE78 \uC774\uB3D9\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4. \uC801\uACFC
    \uC7A5\uC560\uBB3C\uC744 \uB6F0\uC5B4\uB118\uC744 \uC218 \uC788\uC2B5\uB2C8\uB2E4.
    \uB8E9\uACFC \uBE44\uC20D\uC744 \uACF5\uACA9\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4. "
  - "\uC0C1\uD558\uC88C\uC6B0 \uB610\uB294 \uB300\uAC01\uC120\uC73C\uB85C 2\uCE78
    \uB610\uB294 \uB098\uC774\uD2B8\uCC98\uB7FC \uC774\uB3D9\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.
    \uC801\uACFC \uC7A5\uC560\uBB3C\uC744 \uB6F0\uC5B4\uB118\uC744 \uC218 \uC788\uC2B5\uB2C8\uB2E4.
    \uB098\uC774\uD2B8\uB97C \uACF5\uACA9\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4. "
  PPdesc_text: {fileID: 2140724543}
  PPflavor:
  - "\"\uB2E8\uC21C\uD558\uACE0 \uAC15\uB825\uD558\uAC8C.\" "
  - "\"\uD2B9\uC815 \uC0C9\uC0C1\uC5D0 \uD3B8\uD5A5\uB420 \uAC00\uB2A5\uC131\uC774
    \uC788\uC2B5\uB2C8\uB2E4.\" "
  - "\"\uB298 \uC0C8\uB85C\uC6B4 \uBAA8\uD5D8\uC744 \uCC3E\uACE0 \uC788\uB294 \uC5EC\uD589\uC790.\" "
  - "\"\uC815\uC608\uB77C\uACE0 \uD574\uB3C4 \uACF5\uC8FC\uB2D8\uC744 \uB9C9\uC744
    \uC21C \uC5C6\uC2B5\uB2C8\uB2E4.\" "
  - 
  - "\"\uCCB4\uC2A4 \uCD5C\uAC15\uC758 \uAE30\uBB3C.\" "
  - "\"\uAE4C\uB2E4\uB86D\uC9C0\uB9CC \uC720\uC5F0\uD55C \uB9C8\uBC95\uC0AC.\" "
  - "\"\uC800\uB3CC\uC801\uC774\uACE0 \uACFC\uAC10\uD55C \uC804\uC0AC\" "
  - "\"\uB8E9, \uBE44\uC20D, \uB098\uC774\uD2B8.\" "
  - "\"\uC0B6\uC740 \uB298 \uC0C8\uB85C\uC6B4 \uBAA8\uD5D8\uC774\uB2E4.\" "
  - "\"2\uCE78\uBC16\uC5D0 \uBABB\uAC00\uC9C0\uB9CC\u2026 \uB6F0\uC5B4\uAC08 \uC218
    \uC788\uC2B5\uB2C8\uB2E4.\" "
  - "\"\uC810\uD504\u2026 \uC88B\uC544\uD558\uC138\uC694?\""
