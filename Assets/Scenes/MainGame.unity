    \uBD88\uC644\uC804\uD55C \uD56D\uD574\uC774\uB2E4.|\uC0B0\uB2E4\uB294 \uAC83\uC740
    \uC0DD\uAC01\uD55C\uB2E4\uB294 \uAC83\uC774\uB2E4.|\uBA39\uAE30 \uC704\uD574
    \uC0B4\uC9C0 \uB9D0\uACE0, \uC0B4\uAE30 \uC704\uD574 \uBA39\uC5B4\uB77C."
  - "\uBD84\uB178\uB294 \uADF8\uAC83\uC744 \uBD80\uC740 \uACF3\uBCF4\uB2E4 \uB2F4\uC740
    \uACF3\uC744 \uB354 \uC190\uC0C1\uC2DC\uD0A8\uB2E4.|\uD55C\uB54C\uC758 \uBD84\uD568\uC744
    \uCC38\uC73C\uBA74 \uBC31 \uB0A0\uC758 \uADFC\uC2EC\uC744 \uBA74\uD55C\uB2E4.|\uD654\uAC00
    \uB098\uBA74 \uC5F4\uAE4C\uC9C0 \uC138\uC5B4\uB77C.<br>\uB354 \uD654\uAC00 \uB098\uBA74
    \uBC31\uAE4C\uC9C0 \uC138\uC5B4\uB77C.|\uAC15\uC790\uC758 \uB178\uC5EC\uC6C0\uC740
    \uADF8 \uC2DC\uAE30\uB97C \uAE30\uB2E4\uB9B4 \uC218 \uC788\uB2E4.|\uBD84\uB178\uB294
    \uBB34\uBAA8\uD568\uC5D0\uC11C \uC2DC\uC791\uD558\uC5EC \uD6C4\uD68C\uB85C \uB05D\uB09C\uB2E4.|\uBD84\uB178\uB85C
    \uD55C \uC77C\uC740 \uC2E4\uD328\uD558\uAE30 \uB9C8\uB828\uC774\uB2E4. "
  - "\uBFCC\uB9AC\uAC00 \uB04A\uAE34 \uB098\uBB34\uC5D0\uB294 \uBB3C\uC744 \uC900\uB4E4
    \uC18C\uC6A9\uC5C6\uB2E4.|\uD76C\uB9DD\uC774 \uD56D\uC0C1 \uC2E4\uD604\uB418\uC9C0\uB294
    \uC54A\uC544\uB3C4 \uB098\uB294 \uD56D\uC0C1 \uD76C\uB9DD\uD55C\uB2E4.|\uBAA9\uC801
    \uC5C6\uB294 \uD76C\uB9DD\uC740 \uC9C0\uC18D\uB420 \uC218 \uC5C6\uB2E4.|\uD76C\uB9DD\uC740
    \uC5B4\uB460 \uC18D\uC5D0\uC11C \uC2DC\uC791\uB41C\uB2E4.|\uD76C\uB9DD\uD558\uC9C0
    \uC54A\uB294 \uC790\uB294 \uC2E4\uB9DD\uD558\uC9C0\uB3C4 \uC54A\uB294\uB2E4. "
  - '|'
  - '|'
  - '|'
  - '|'
  - "\uC2AC\uD514\uC740 \uCC30\uB098\uC758 \uACE0\uB1CC\uC774\uB2E4.|\uC9C0\uB098\uAC04
    \uC2AC\uD514\uC5D0 \uC0C8 \uB208\uBB3C\uC744 \uB0AD\uBE44\uD558\uC9C0 \uB9D0\uB77C.|\uC2AC\uD514\uC740
    \uAC00\uC7A5 \uC131\uC2E4\uD55C \uCE5C\uAD6C\uC774\uB2E4.|\uC2AC\uD514\uC740
    \uB2F9\uC2E0\uC774 \uB9CE\uC774 \uC0AC\uB791\uD588\uB2E4\uB294 \uAC83\uC744 \uBCF4\uC5EC\uC900\uB2E4.|\uC2AC\uD514\uC740
    \uC6B0\uB9AC\uB97C \uB354\uC6B1 \uC778\uAC04\uC801\uC73C\uB85C \uB9CC\uB4E4\uC5B4\uC900\uB2E4. "
  - '|'
  clearMsg:
  - "\uB54C\uB85C\uB294 \uAE30\uD68C\uB97C \uB193\uCE58\uB294 \uAC83\uC774 \uAE30\uD68C\uC77C
    \uC218 \uC788\uB2E4.|\uC5B4\uB824\uC6B4 \uC77C\uC740 \uC2DC\uAC04\uC774 \uD574\uACB0\uD574\uC900\uB2E4.|\uC2DC\uAC04\uC740
    \uC778\uAC04\uC774 \uC4F8 \uC218 \uC788\uB294 \uAC83\uC911\uC5D0<br>\uAC00\uC7A5
    \uAC12\uC9C4 \uAC83\uC774\uB2E4."
  - "\uBB34\uB825\uC5D0\uB9CC \uC758\uC874\uD55C\uB2E4\uBA74 \uC790\uCE6B \uBAA8\uB4E0
    \uAC83\uC744 \uB9DD\uCE60 \uC218\uB3C4 \uC788\uB2E4.|\uC790\uC2E0\uC758 \uBC1C\uC5D0
    \uAC78\uB824 \uB118\uC5B4\uC9C0\uC9C0 \uC54A\uAC8C \uC870\uC2EC\uD574\uC57C \uD55C\uB2E4.|\uD3C9\uD654\uC57C\uB9D0\uB85C
    \uAC00\uC7A5 \uAC15\uD55C \uD798\uC774\uB2E4."
  - "\uC2DC\uC57C\uAC00 \uB113\uC9C0 \uC54A\uC740 \uC790\uB294 \uAE38\uC744 \uC783\uAE30
    \uB9C8\uB828\uC774\uB2E4.|\uC27D\uACE0 \uAC04\uB2E8\uD55C \uAE38\uC77C\uC218\uB85D
    \uC790\uC2E0\uC774 \uAC00\uB294 \uAE38\uC744 \uC758\uC2EC\uD558\uB77C.|\uC9D1\uCC29\uC744
    \uBC84\uB9AC\uB294 \uC790\uB9CC\uC774 \uCD5C\uACE0\uAC00 \uB420 \uC218 \uC788\uB2E4."
  - "\uB54C\uB85C\uB294 \uAE30\uD68C\uB97C \uB193\uCE58\uB294 \uAC83\uC774 \uAE30\uD68C\uC77C
    \uC218 \uC788\uB2E4.|\uC5B4\uB824\uC6B4 \uC77C\uC740 \uC2DC\uAC04\uC774 \uD574\uACB0\uD574\uC900\uB2E4.|\uC2DC\uAC04\uC740
    \uC778\uAC04\uC774 \uC4F8 \uC218 \uC788\uB294 \uAC83\uC911\uC5D0<br>\uAC00\uC7A5
    \uAC12\uC9C4 \uAC83\uC774\uB2E4."
  - "\uB54C\uB85C\uB294 \uAE30\uD68C\uB97C \uB193\uCE58\uB294 \uAC83\uC774 \uAE30\uD68C\uC77C
    \uC218 \uC788\uB2E4.|\uC5B4\uB824\uC6B4 \uC77C\uC740 \uC2DC\uAC04\uC774 \uD574\uACB0\uD574\uC900\uB2E4.|\uC2DC\uAC04\uC740
    \uC778\uAC04\uC774 \uC4F8 \uC218 \uC788\uB294 \uAC83\uC911\uC5D0<br>\uAC00\uC7A5
    \uAC12\uC9C4 \uAC83\uC774\uB2E4."
  - "\uB54C\uB85C\uB294 \uAE30\uD68C\uB97C \uB193\uCE58\uB294 \uAC83\uC774 \uAE30\uD68C\uC77C
    \uC218 \uC788\uB2E4.|\uC5B4\uB824\uC6B4 \uC77C\uC740 \uC2DC\uAC04\uC774 \uD574\uACB0\uD574\uC900\uB2E4.|\uC2DC\uAC04\uC740
